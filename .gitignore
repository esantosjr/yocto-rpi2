# Upstream repositories are cloned separately.
/poky/
/meta-raspberrypi/
/sources/

# Track the manual build configuration, but no generated build files.
/build/*
!/build/conf/
/build/conf/*
!/build/conf/local.conf
!/build/conf/bblayers.conf
/build-*/
/downloads/
/sstate-cache/

# Local environments and credentials.
/.venv/
.env
.env.*
!.env.example
